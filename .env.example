# Docker Compose reads .env. Plain npm start does not load it automatically.
PORTAL_DOMAIN=consult.your-school-domain.edu
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-generated-secret-at-least-32-characters-long

# Render backend only: set through its secret environment configuration.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# PUBLIC_URL=https://your-frontend.netlify.app
# TRUST_PROXY=1

# Netlify build variables (public origins only; never the database credential).
# RENDER_API_URL=https://your-backend.onrender.com
